{
  "name": "foc-demo",
  "version": "0.1.0",
  "description": "CLI demo for foc-encryption — encrypt/decrypt files with FOC warm storage",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "wireit",
    "build:protect": "node scripts/build-protect.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "wireit": {
    "build": {
      "command": "tsc --pretty && node scripts/build-protect.mjs",
      "clean": "if-file-deleted",
      "files": ["src/**/*.ts", "scripts/build-protect.mjs", "tsconfig.json"],
      "output": ["dist/**"],
      "dependencies": ["../foc-encryption:build"]
    }
  },
  "bin": {
    "foc-demo": "./dist/cli.js"
  },
  "dependencies": {
    "@filoz/synapse-sdk": "^0.40.0",
    "@scure/bip39": "1.6.0",
    "@zip.js/zip.js": "2.8.11",
    "cleye": "^1.3.2",
    "foc-encryption": "workspace:*",
    "viem": "^2.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "0.27.4",
    "typescript": "^5.9.0",
    "vitest": "^3.0.0",
    "wireit": "^0.14.0"
  }
}
